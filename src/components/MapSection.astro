---
import { contact, ui } from "../data/site";
import { mapEmbedHref } from "../lib/contact";
---
<section class="map" aria-label={ui.mapTitle}>
  <iframe src={mapEmbedHref(contact)} title={ui.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</section>

<style>
  .map { height: 340px; background: #e6e6e6; }
  .map iframe { display: block; width: 100%; height: 100%; border: 0; filter: grayscale(1) contrast(.95); }
  @media (max-width: 720px) { .map { height: 260px; } }
</style>
