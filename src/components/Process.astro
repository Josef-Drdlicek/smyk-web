---
import SectionHead from "./SectionHead.astro";
import { sections, steps } from "../data/site";

const STAGGER_MS = 80;
---
<section class="sec" id={sections.process.id}>
  <div class="wrap">
    <SectionHead section={sections.process} />
    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <li class="step reveal" style={`--delay:${i * STAGGER_MS}ms`}>
          <span class="step-n tnum">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 32px; }
  .step { position: relative; padding-top: 28px; border-top: 2px solid var(--fg); }
  .step-n { display: block; font-size: 56px; line-height: 1; font-weight: 300; margin-bottom: 18px; color: var(--accent); }
  .step h3 { font-size: 19px; }
  .step p { margin: 10px 0 0; font-size: 15px; color: var(--muted); }
  @media (max-width: 960px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .step { display: grid; grid-template-columns: 72px 1fr; column-gap: 8px; padding: 24px 0; border-top: 1px solid var(--line-2); }
    .step-n { grid-row: span 2; margin: 0; font-size: 44px; }
    .step p { grid-column: 2; }
  }
</style>
