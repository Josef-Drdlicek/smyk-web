---
import SectionHead from "./SectionHead.astro";
import { sections, steps } from "../data/site";

const STAGGER_MS = 80;
---
<section class="sec" id={sections.process.id}>
  <div class="wrap">
    <SectionHead section={sections.process} />
    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <li class="step reveal" style={`--delay:${i * STAGGER_MS}ms`}>
          <span class="step-n tnum">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; border-top: 1px solid var(--line-2); }
  .step { padding: 28px 24px 8px 0; transition-delay: var(--delay); }
  .step-n { display: block; font: 600 40px/1 var(--display); color: var(--accent); margin-bottom: 20px; }
  .step h3 { font-size: 17px; }
  .step p { margin: 8px 0 0; color: var(--muted); font-size: 15px; }
  @media (max-width: 960px) {
    .steps { grid-template-columns: 1fr; border-top: 0; }
    .step { display: grid; grid-template-columns: 64px 1fr; column-gap: 8px; padding: 22px 0; border-top: 1px solid var(--line); }
    .step-n { grid-row: span 2; margin: 0; font-size: 36px; }
    .step p { grid-column: 2; }
  }
</style>
