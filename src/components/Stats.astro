---
import SectionHead from "./SectionHead.astro";
import { sections, stats } from "../data/site";
---
<section class="sec group" id={sections.group.id}>
  <div class="wrap">
    <SectionHead section={sections.group} />
    <div class="stats">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--delay:${i * 100}ms`}>
          <b class="tnum">{s.value}</b>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .group { background: var(--dark); color: #fff; }
  .group :global(.hl) { color: #7fc4a8; }
  .group :global(.sec-lede) { color: rgba(255, 255, 255, .75); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; }
  .stat { padding: 8px 32px; }
  .stat + .stat { border-left: 1px solid rgba(255, 255, 255, .18); }
  .stat b { display: block; font-size: clamp(52px, 6vw, 84px); line-height: 1; font-weight: 300; letter-spacing: -0.02em; }
  .stat h3 { margin-top: 14px; font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .stat p { margin: 10px auto 0; max-width: 32ch; color: rgba(255, 255, 255, .72); font-size: 15px; }
  @media (max-width: 860px) {
    .stats { grid-template-columns: 1fr; }
    .stat { padding: 32px 0; }
    .stat + .stat { border-left: 0; border-top: 1px solid rgba(255, 255, 255, .18); }
  }
</style>
