---
import type { Section } from "../data/site";

interface Props { section: Section; align?: "center" | "start" }
const { section, align = "center" } = Astro.props;
const { eyebrow, title, lede } = section;
---
<div class:list={["sec-head reveal", align]}>
  <div class="kicker">{eyebrow}</div>
  {title && <h2 class="upper h2">{title.pre} <span class="hl">{title.highlight}</span>{title.post && ` ${title.post}`}</h2>}
  {lede && <p class="sec-lede">{lede}</p>}
</div>

<style>
  .sec-head { display: grid; gap: 22px; margin-bottom: 56px; }
  .center { justify-items: center; text-align: center; margin-inline: auto; max-width: 820px; }
  .start { max-width: 720px; }
  .h2 { font-size: clamp(30px, 3.6vw, 48px); }
  .sec-lede { margin: 0; color: var(--muted); font-size: 17px; max-width: 60ch; }
</style>
