---
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
import { contact, formCopy, sections, ui } from "../data/site";
import { mailtoHref, mapHref, officeAddress, telHref } from "../lib/contact";

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const { fields } = formCopy;
---
<section class="sec" id={sections.contact.id}>
  <div class="wrap contact-in">
    <div>
      <SectionHead section={sections.contact} />
      <div class="big-links">
        <a class="tnum" href={telHref(contact.phone)}>{contact.phone}</a>
        <a href={mailtoHref(contact.email)}>{contact.email}</a>
      </div>
      <div class="office">
        <strong>{contact.office.label}</strong><br />
        {officeAddress(contact)}<br />
        <a href={mapHref(contact)} target="_blank" rel="noopener">{ui.showOnMap}</a>
      </div>
      <button class="btn btn-secondary" type="button" data-vcard><Icon name="user" />{ui.saveContact}</button>
    </div>

    <form class="form reveal" data-contact-form novalidate>
      <fieldset class="chips">
        <legend>{formCopy.typeLegend}</legend>
        {formCopy.types.map((v, i) => (
          <Fragment>
            <input type="radio" name="typ" id={`typ-${i}`} value={v} checked={i === 0} />
            <label for={`typ-${i}`}>{capitalize(v)}</label>
          </Fragment>
        ))}
      </fieldset>
      <div class="row2">
        <label>{fields.name.label}<input name="jmeno" autocomplete="name" required /></label>
        <label>{fields.phone.label}<input name="telefon" type="tel" autocomplete="tel" required /></label>
      </div>
      <label>{fields.location.label}<input name="lokalita" placeholder={fields.location.placeholder} /></label>
      <label>{fields.message.label}<textarea name="zprava" placeholder={fields.message.placeholder}></textarea></label>
      <button class="btn btn-primary" type="submit">{formCopy.submit}<Icon name="arrow" /></button>
      <p class="note">{formCopy.note}</p>
      <p class="form-status" data-form-status role="status" hidden></p>
    </form>
  </div>
</section>

<style>
  .contact-in { display: grid; grid-template-columns: 1fr 1.05fr; gap: 64px; align-items: start; }
  .big-links { display: grid; gap: 4px; }
  .big-links a { font: 600 clamp(22px, 2.8vw, 32px)/1.3 var(--display); text-decoration: none; overflow-wrap: anywhere; }
  .big-links a:hover { color: var(--accent); }
  .office { margin: 32px 0 24px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: 15px; }
  .office strong { color: var(--fg); }
  .office a { color: var(--accent); }
  .form { display: grid; gap: 18px; padding: 32px; border-radius: 20px; border: 1px solid var(--line); background: var(--surface); box-shadow: var(--shadow); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form label { display: grid; gap: 6px; font-size: 14px; font-weight: 500; color: var(--fg); min-width: 0; }
  .form input, .form textarea { font: 400 16px var(--body); color: var(--fg); background: var(--surface); border: 1px solid var(--line-2); border-radius: 10px; padding: 12px 14px; width: 100%; min-height: 48px; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .form textarea { min-height: 120px; resize: vertical; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; border: 0; padding: 0; margin: 0; }
  .chips legend { font-size: 14px; font-weight: 500; margin-bottom: 10px; padding: 0; }
  .chips input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .chips label { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px; border-radius: 999px; border: 1px solid var(--line-2); font-weight: 500; font-size: 14px; cursor: pointer; }
  .chips input:checked + label { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .chips input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
  .note { font-size: 13px; color: var(--muted); margin: 0; }
  .form-status { font-size: 14px; color: var(--accent); font-weight: 600; margin: 0; }
  @media (max-width: 960px) { .contact-in { grid-template-columns: 1fr; gap: 40px; } }
  @media (max-width: 720px) { .row2 { grid-template-columns: 1fr; } .form { padding: 22px; } }
</style>

<script>
  import { initContactForm } from "../scripts/contact-form";
  import { initVCard } from "../scripts/vcard";
  initContactForm();
  initVCard();
</script>
