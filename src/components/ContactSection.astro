---
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
import { contact, formCopy, paths, sections, ui } from "../data/site";
import { mailtoHref, mapHref, officeAddress, smsHref, telHref } from "../lib/contact";

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const { fields } = formCopy;
// Sample message follows the hero tab; scripts/path-tabs.ts swaps it.
const sample = paths[0].sampleMessage;
---
<section class="sec" id={sections.contact.id}>
  <div class="wrap contact-in">
    <div>
      <SectionHead section={sections.contact} align="start" />
      <div class="big-links">
        <a class="tnum" href={telHref(contact.phone)}>{contact.phone}</a>
        <a href={mailtoHref(contact.email)}>{contact.email}</a>
      </div>

      <div class="msg-card reveal">
        <div class="msg-head"><span class="kicker">{ui.messageHint}</span><small>{contact.replyNote}</small></div>
        <p class="msg" data-field="sampleMessage" data-swap>{sample}</p>
        <div class="msg-actions">
          <a class="btn btn-primary btn-sm" data-sms href={smsHref(contact.phone, sample)}><Icon name="chat" />{ui.sendSms}</a>
          <button class="btn btn-secondary btn-sm" type="button" data-copy-field="sampleMessage" data-copied-label={ui.copied}><Icon name="copy" /><span>{ui.copyMessage}</span></button>
        </div>
      </div>

      <div class="office">
        <strong>{contact.office.label}</strong><br />
        {officeAddress(contact)}<br />
        <a href={mapHref(contact)} target="_blank" rel="noopener">{ui.showOnMap}</a>
      </div>
      <button class="btn btn-secondary btn-sm" type="button" data-vcard><Icon name="user" />{ui.saveContact}</button>
    </div>

    <form class="form reveal" data-contact-form novalidate>
      <fieldset class="chips">
        <legend>{formCopy.typeLegend}</legend>
        {formCopy.types.map((v, i) => (
          <Fragment>
            <input type="radio" name="typ" id={`typ-${i}`} value={v} checked={i === 0} />
            <label for={`typ-${i}`}>{capitalize(v)}</label>
          </Fragment>
        ))}
      </fieldset>
      <div class="row2">
        <label>{fields.name.label}<input name="jmeno" autocomplete="name" required /></label>
        <label>{fields.phone.label}<input name="telefon" type="tel" autocomplete="tel" required /></label>
      </div>
      <label>{fields.location.label}<input name="lokalita" placeholder={fields.location.placeholder} /></label>
      <label>{fields.message.label}<textarea name="zprava" placeholder={fields.message.placeholder}></textarea></label>
      <button class="btn btn-primary" type="submit">{formCopy.submit}<Icon name="arrow" /></button>
      <p class="note">{formCopy.note}</p>
      <p class="form-status" data-form-status role="status" hidden></p>
    </form>
  </div>
</section>

<style>
  .contact-in { display: grid; grid-template-columns: 1fr 1.05fr; gap: 72px; align-items: start; }
  .contact-in :global(.sec-head) { margin-bottom: 32px; }
  .big-links { display: grid; gap: 4px; }
  .big-links a { font-size: clamp(22px, 2.6vw, 30px); font-weight: 800; line-height: 1.3; text-decoration: none; overflow-wrap: anywhere; }
  .big-links a:hover { color: var(--accent); }

  .msg-card { margin-top: 36px; padding: 24px; background: var(--light); display: grid; gap: 14px; }
  .msg-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; }
  .msg-head small { color: var(--muted); font-size: 13px; }
  .msg { margin: 0; padding: 14px 16px; border-radius: 4px 16px 16px 16px; background: var(--surface); font-size: 15px; line-height: 1.55; }
  [data-swap] { transition: opacity .2s ease; }
  [data-swap]:global(.out) { opacity: 0; }
  .msg-actions { display: flex; flex-wrap: wrap; gap: 8px; }

  .office { margin: 32px 0 20px; color: var(--muted); font-size: 15px; }
  .office strong { color: var(--fg); }
  .office a { color: var(--accent); font-weight: 700; }

  .form { display: grid; gap: 18px; padding: 36px; background: var(--light); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form label { display: grid; gap: 6px; font-size: 14px; font-weight: 700; min-width: 0; }
  .form input, .form textarea { font: 400 16px var(--font); color: var(--fg); background: var(--surface); border: 1px solid var(--line-2); border-radius: 4px; padding: 12px 14px; width: 100%; min-height: 48px; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--fg); box-shadow: 0 0 0 3px rgba(0, 0, 0, .08); }
  .form textarea { min-height: 120px; resize: vertical; }
  .form .btn { justify-self: start; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; border: 0; padding: 0; margin: 0; }
  .chips legend { font-size: 14px; font-weight: 700; margin-bottom: 10px; padding: 0; }
  .chips input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .chips label { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px; border-radius: 999px; border: 1.5px solid var(--line-2); background: var(--surface); font-size: 14px; cursor: pointer; }
  .chips input:checked + label { background: var(--fg); border-color: var(--fg); color: #fff; }
  .chips input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
  .note { font-size: 13px; color: var(--muted); margin: 0; }
  .form-status { font-size: 14px; color: var(--accent); font-weight: 700; margin: 0; }
  @media (max-width: 960px) { .contact-in { grid-template-columns: 1fr; gap: 48px; } }
  @media (max-width: 720px) {
    .row2 { grid-template-columns: 1fr; }
    .form { padding: 24px 16px; margin-inline: -16px; }
    .form .btn { justify-self: stretch; white-space: normal; }
  }
</style>

<script>
  import { initClipboard } from "../scripts/clipboard";
  import { initContactForm } from "../scripts/contact-form";
  import { initVCard } from "../scripts/vcard";
  initClipboard();
  initContactForm();
  initVCard();
</script>
