---
import Icon from "./Icon.astro";
import { contact, fullName, ui } from "../data/site";
import { mailtoHref, telHref } from "../lib/contact";

const webLabel = new URL(contact.web).hostname.replace(/^www\./, "");
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot-in">
    <div>
      <strong>{contact.company}</strong>
      <p>{contact.legal.address}<br />IČO {contact.legal.ico}</p>
      <div class="links">
        <a class="tnum" href={telHref(contact.phone)}><Icon name="phone" />{contact.phone}</a>
        <a href={mailtoHref(contact.email)}><Icon name="mail" />{contact.email}</a>
      </div>
    </div>
    <div class="brand">
      <b>{fullName}</b>
      <small>{contact.role}</small>
      <p>© {year} {fullName} · <a href={contact.web} target="_blank" rel="noopener">{webLabel}</a></p>
    </div>
  </div>
</footer>

<div class="callbar">
  <a class="btn btn-primary" href={telHref(contact.phone)}><Icon name="phone" />{ui.call}</a>
  <a class="btn btn-secondary" href={mailtoHref(contact.email)}><Icon name="mail" />{ui.emailShort}</a>
</div>

<style>
  .foot { background: var(--dark); color: rgba(255, 255, 255, .78); font-size: 14px; }
  .foot-in { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 32px; padding-block: 52px; }
  .foot strong { color: #fff; }
  .foot p { margin: 6px 0 0; }
  .foot a { color: #fff; text-decoration: none; }
  .foot a:hover { color: rgba(255, 255, 255, .7); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 16px; }
  .links a { display: inline-flex; align-items: center; gap: 8px; min-height: 32px; }
  .links :global(svg) { width: 16px; height: 16px; }
  .brand { display: grid; justify-items: end; text-align: right; }
  .brand b { color: #fff; font-size: 20px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .brand small { margin-top: 6px; font-size: 10px; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; }
  .brand p { margin-top: 18px; font-size: 13px; }
  .callbar { display: none; }
  @media (max-width: 720px) {
    .brand { justify-items: start; text-align: left; }
    .callbar { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 15;
      background: rgba(255, 255, 255, .96); border-top: 1px solid var(--line);
      padding: 10px max(12px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(12px, env(safe-area-inset-left, 0px)); }
    :global(body) { padding-bottom: 72px; }
  }
</style>
