---
import Icon from "./Icon.astro";
import { contact, fullName, sections, ui } from "../data/site";
import { telHref } from "../lib/contact";

const navItems = Object.values(sections);
---
<header class="top" data-header>
  <div class="top-row">
    <nav class="nav" id="main-nav" aria-label={ui.navLabel} data-nav>
      {navItems.map((s) => <a href={`#${s.id}`}>{s.nav}</a>)}
    </nav>
    <a class="brand" href="#top" aria-label={fullName}>
      <b>{fullName}</b>
      <small>{contact.role}</small>
    </a>
    <div class="right">
      <a class="phone tnum" href={telHref(contact.phone)}><Icon name="phone" /><span>{contact.phone}</span></a>
      <button class="menu" type="button" aria-expanded="false" aria-controls="main-nav" aria-label={ui.menu} data-menu>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .top { position: fixed; inset: 0 0 auto; z-index: 20; height: var(--header-h); color: #fff;
    padding-top: env(safe-area-inset-top, 0px); transition: height .35s ease, background .35s ease; }
  .top:global(.scrolled), .top:global(.open) { height: 72px; background: rgba(0, 0, 0, .86); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .top-row { height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 24px;
    padding: 0 max(40px, env(safe-area-inset-right, 0px)) 0 max(40px, env(safe-area-inset-left, 0px)); }
  .top a { text-decoration: none; text-shadow: 0 1px 3px rgba(0, 0, 0, .4); }

  .nav { display: flex; gap: 22px; }
  .nav a { font-size: 14px; font-weight: 700; white-space: nowrap; }
  .nav a:hover, .phone:hover { color: rgba(255, 255, 255, .72); }

  .brand { justify-self: center; display: grid; justify-items: center; line-height: 1; gap: 6px; }
  .brand b { font-size: 20px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .brand small { font-size: 10px; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; opacity: .8; }

  .right { justify-self: end; display: flex; align-items: center; gap: 8px; }
  .phone { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; white-space: nowrap; min-height: 44px; }
  .phone :global(svg) { width: 16px; height: 16px; }

  .menu { display: none; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; padding: 12px 10px; }
  .menu span { display: block; height: 2px; background: #fff; transition: transform .25s ease; }
  .menu span + span { margin-top: 8px; }
  .menu[aria-expanded="true"] span:first-child { transform: translateY(5px) rotate(45deg); }
  .menu[aria-expanded="true"] span:last-child { transform: translateY(-5px) rotate(-45deg); }

  @media (max-width: 1100px) {
    .top-row { grid-template-columns: 1fr auto; padding: 0 max(16px, env(safe-area-inset-right, 0px)) 0 max(16px, env(safe-area-inset-left, 0px)); }
    .brand { justify-self: start; justify-items: start; grid-row: 1; }
    .menu { display: block; }
    .nav { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; gap: 0;
      background: rgba(0, 0, 0, .92); padding: 8px 16px 20px; }
    .nav a { padding: 14px 0; font-size: 17px; border-bottom: 1px solid rgba(255, 255, 255, .12); }
    .top:global(.open) .nav { display: flex; }
  }
  @media (max-width: 720px) {
    .phone span { display: none; }
    .phone { width: 44px; justify-content: center; }
    .phone :global(svg) { width: 20px; height: 20px; }
    .brand b { font-size: 16px; letter-spacing: .1em; }
    .brand small { font-size: 9px; letter-spacing: .2em; }
  }
</style>

<script>
  import { initHeader } from "../scripts/header";
  initHeader();
</script>
