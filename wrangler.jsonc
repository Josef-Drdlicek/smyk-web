{
  "name": "smyk-web",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  // Requires the jansmejkalreality.cz zone to be active in Cloudflare (nameservers moved) before `npm run deploy`.
  "routes": [
    { "pattern": "jansmejkalreality.cz", "custom_domain": true },
    { "pattern": "www.jansmejkalreality.cz", "custom_domain": true }
  ]
}
